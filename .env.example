NODE_ENV=development
SERVER_PORT=3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
MALIGN_TEST_DATABASE_URL=postgresql://malign_local:malign_local_only@127.0.0.1:55432/postgres
MALIGN_PG_BIN=/usr/local/bin

# M2-2 productive transport placeholders. Values below are local-only and are not provider credentials.
MALIGN_APP_DATABASE_URL=postgresql://malign_local:malign_local_only@127.0.0.1:55432/postgres
MALIGN_OUTBOX_DATABASE_URL=postgresql://malign_local:malign_local_only@127.0.0.1:55432/postgres
MALIGN_LISTENER_DATABASE_URL=postgresql://malign_local:malign_local_only@127.0.0.1:55432/postgres
MALIGN_ALLOWED_ORIGINS=https://localhost:3000
MALIGN_NODE_ID=local-node
MALIGN_TLS_MODE=disabled
MALIGN_TRUSTED_PROXY_ADDRESSES=
MALIGN_REALTIME_FEED_BATCH_SIZE=100
MALIGN_REALTIME_CATCHUP_MS=5000
MALIGN_OUTBOX_POLL_MS=100
MALIGN_SHUTDOWN_GRACE_MS=10000
MALIGN_TLS_KEY_PATH=
MALIGN_TLS_CERT_PATH=

# Auth0/JWKS placeholders; productive use must supply real secrets outside the repository.
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=https://YOUR_API_IDENTIFIER
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_REQUIRED_SCOPES=malign:connect
AUTH0_JWKS_TIMEOUT_MS=3000
AUTH0_CLOCK_TOLERANCE_SECONDS=2
APP_BASE_URL=https://localhost:3000
